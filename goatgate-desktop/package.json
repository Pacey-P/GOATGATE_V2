{
  "name": "goatgate-desktop",
  "version": "1.0.0",
  "description": "GOATGATE Desktop capture and streaming client",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "form-data": "^4.0.0",
    "vigemclient": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.goatgate.gateway",
    "productName": "GOATGATE Desktop Gateway",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "logo.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GOATGATE Gateway"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ]
  }
}
